# ── Clerk Auth ────────────────────────────────────────
# Get these from https://dashboard.clerk.com → API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=sk_test_YOUR_SECRET_KEY

# Clerk redirect URLs (adjust if running on a different port)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# ── API Backend ────────────────────────────────────────
# URL of the FastAPI backend — used by Next.js rewrites and direct fetch calls.
# Leave as localhost:8000 for local development.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Stripe (for client-side redirect) ─────────────────
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_PUBLISHABLE_KEY

# ── Public site URL (SEO) ─────────────────────────────
# Canonical origin of the marketing site, no trailing slash. Used for canonical
# <link> tags, Open Graph image URLs, sitemap.xml and robots.txt. MUST match the
# domain the site is actually served from, or canonicals will point elsewhere and
# the pages will not rank. Leave UNSET in production — it then defaults to the
# canonical domain (https://myfounder.vercel.app). Only set it to override, e.g.
# a custom domain, a staging origin, or http://localhost:3000 locally.
# NEXT_PUBLIC_SITE_URL=https://myfounder.vercel.app

# ── Google Analytics 4 (optional) ─────────────────────
# GA4 Measurement ID from https://analytics.google.com → Admin → Data streams
# (format: G-XXXXXXXXXX). If unset, gtag.js is never injected and no requests are
# made — same opt-in behaviour as PostHog below. Inlined at `next build`.
# Set /thank-you as the conversion event in GA once traffic is flowing.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── PostHog analytics (optional) ──────────────────────
# Project API key from https://us.posthog.com → Project Settings. If unset,
# analytics is fully disabled (no init, no events) — fine for local dev.
# NOTE: NEXT_PUBLIC_* values are inlined at `next build` time. Production
# deploys are `vercel --prebuilt` from the laptop, so the key must be in the
# local env used for the build — the Vercel dashboard alone won't reach the bundle.
NEXT_PUBLIC_POSTHOG_KEY=phc_YOUR_PROJECT_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── n8n editor link-out (workflows dashboard) ──────────
# Public base URL of the self-hosted n8n instance, used ONLY to build the
# "View / Edit in n8n" link-out on the Workflows pages (ADR-008, O-5):
#   ${NEXT_PUBLIC_N8N_BASE_URL}/workflow/${n8n_workflow_id}
# This is the browser-facing mirror of the backend's server-side N8N_BASE_URL.
# If unset, the editor link is simply hidden (no broken link).
NEXT_PUBLIC_N8N_BASE_URL=http://localhost:5678
